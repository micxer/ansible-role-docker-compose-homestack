APP_NAME = git-forge
APP_SLOGAN = Hier wird gefuddelt.
RUN_USER = git
RUN_MODE = prod
WORK_PATH = /var/lib/gitea

#DEFAULT CONFIGURATION:
# AppPath:    /usr/local/bin/forgejo
# WorkPath:   /var/lib/gitea
# CustomPath: /var/lib/gitea/custom
# ConfigFile: /var/lib/gitea/custom/conf/app.ini
#
# APP_DATA_PATH: s(AppWorkPath)/data

[repository]
# %(APP_DATA_PATH)s/forgejo-repositories
ROOT = /var/lib/gitea/data/forgejo-repositories

[repository.editor]

[repository.pull-request]

[repository.issue]

[repository.upload]
TEMP_PATH = /tmp/gitea/uploads

[repository.release]

[repository.signing]
DEFAULT_TRUST_MODEL = committer

[repository.local]
LOCAL_COPY_PATH = /tmp/gitea/local-repo

[repository.mimetype_mapping]

[badges]

[cors]

[ui]

[ui.admin]

[ui.user]

[ui.meta]

[ui.notification]

[ui.svg]

[ui.csv]

[markdown]

[server]
APP_DATA_PATH = /var/lib/gitea/data
# Protocol for internal communication (http because Traefik handles TLS termination)
PROTOCOL = http
DOMAIN = git.{{ homestack_git_base_domain }}
ROOT_URL = https://git.{{ homestack_git_base_domain }}/
HTTP_PORT = 3000
DISABLE_SSH = false
; In rootless gitea container only internal ssh server is supported
START_SSH_SERVER = true
# SSH_PORT: Port displayed in git clone URLs (external port, Traefik routes to container)
SSH_PORT = {{ homestack_git_ssh_port }}
# SSH_LISTEN_PORT: Port where SSH server listens inside container (2222 for rootless)
SSH_LISTEN_PORT = 2222
LFS_START_SERVER = true
LFS_JWT_SECRET = {{ homestack_git_lfs_jwt_secret | default(homestack_git_secret_key) }}
OFFLINE_MODE = true

[database]
DB_TYPE = {{ homestack_git_db_type }}
{% if homestack_git_db_type == 'sqlite3' %}
PATH = /var/lib/gitea/data/forgejo.db
{% else %}
HOST = {{ homestack_git_db_host | default('127.0.0.1:3306') }}
NAME = {{ homestack_git_db_name | default('forgejo') }}
USER = {{ homestack_git_db_user | default('forgejo') }}
PASSWD = {{ homestack_git_db_password | default('') }}
{% endif %}
LOG_SQL = false

[indexer]
REPO_INDEXER_ENABLED = {{ homestack_git_repo_indexer_enabled }}

[queue]

[admin]
DISABLE_REGULAR_ORG_CREATION = false
SEND_NOTIFICATION_EMAIL_ON_NEW_USER = true

[security]
INSTALL_LOCK = true
SECRET_KEY = {{ homestack_git_secret_key }}
GLOBAL_TWO_FACTOR_REQUIREMENT = admin
REVERSE_PROXY_LIMIT = 1
REVERSE_PROXY_TRUSTED_PROXIES = *
INTERNAL_TOKEN = {{ homestack_git_internal_token }}
PASSWORD_HASH_ALGO = pbkdf2
MIN_PASSWORD_LENGTH = 16
PASSWORD_COMPLEXITY = lower,upper,digit
PASSWORD_CHECK_PWN = true
[camo]

[openid]
ENABLE_OPENID_SIGNIN = false
ENABLE_OPENID_SIGNUP = false


[oauth2_client]

[service]
DISABLE_REGISTRATION = {{ homestack_git_disable_registration | lower }}
VALID_SITE_URL_SCHEMES = https

[service.explore]

[ssh.minimum_key_sizes]

[webhook]
ALLOWED_HOST_LIST = {{ homestack_git_webhook_allowed_hosts }}
SKIP_TLS_VERIFY = false


[mailer]
ENABLED = {{ (homestack_git_smtp_addr and homestack_git_smtp_port and homestack_git_smtp_user and homestack_git_smtp_passwd) | bool | lower }}
PROTOCOL = smtp
SMTP_ADDR = {{ homestack_git_mailer_host }}
SMTP_PORT = {{ homestack_git_mailer_port }}
FROM = {{ homestack_git_mailer_from }}
USER = {{ homestack_git_mailer_user | default('') }}
PASSWD = {{ homestack_git_mailer_password | default('') }}
MAILER_TYPE = smtp
{% endif %}

[email.incoming]
ENABLED = false

[cache]

[cache.last_commit]

[session]
PROVIDER_CONFIG = /var/lib/gitea/data/sessions
PROVIDER = file
COOKIE_SECURE = true
COOKIE_NAME = i_like_forgejo  # Cookie name for session management
SESSION_LIFE_TIME = 86400
SAME_SITE = lax

[picture]
AVATAR_UPLOAD_PATH = /var/lib/gitea/data/avatars
REPOSITORY_AVATAR_UPLOAD_PATH = /var/lib/gitea/data/repo-avatars

[project]

[attachment]
ENABLED = true

[lfs_client]

[log]
ROOT_PATH = /var/lib/gitea/log
MODE = console,file
LEVEL = Info

[log.console]
LEVEL = Warn

[log.file]
LEVEL = Info
LOG_ROTATE = true
MAX_SIZE_SHIFT = 28  # Log file size: 2^28 bytes = 256MB before rotation
DAILY_ROTATE = true
MAX_DAYS = 7

[cron]
# add specific cron jobs below if necessary

[cron.update_checker]
ENABLED = false

[git]

[metrics]
ENABLED = true
TOKEN = {{ homestack_git_metrics_token }}

